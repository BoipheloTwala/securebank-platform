# SecureBank Platform — Environment Variables
# Copy this file to .env and fill in your values

# SecureBank API base URL (Node.js/Express backend, default port 3000)
VITE_API_URL=http://localhost:3000/api/v1

# App metadata
VITE_APP_NAME=SecureBank Platform
VITE_APP_VERSION=1.0.0

# Set to false to call the real API. Set to true to use mock data
# (required for GRC features — risks, controls, evidence, reports —
#  which have no backend implementation yet).
VITE_ENABLE_MOCK_DATA=false
